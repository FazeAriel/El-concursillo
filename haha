<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>El Concursillo - Prueba completa</title>
<style>
*{box-sizing:border-box}body{margin:0;min-height:100vh;font-family:Arial,sans-serif;color:#fff;background:linear-gradient(135deg,#160b2b,#6d28d9,#24103f);display:flex;align-items:center;justify-content:center;padding:15px}
.game{width:min(850px,100%);min-height:650px;padding:22px;border-radius:28px;background:linear-gradient(145deg,#211236,#5b21b6);box-shadow:0 20px 60px #0008}
.top{display:flex;justify-content:space-between;align-items:center;gap:10px}.logo{font-size:28px;font-weight:900}.lifelines{display:flex;gap:8px}
.life{width:50px;height:50px;border-radius:50%;border:2px solid #ffffffaa;background:#ffffff18;color:white;font-size:20px;cursor:pointer}.life:disabled{opacity:.4;cursor:not-allowed}
.question{margin:35px auto 25px;padding:25px;border:2px solid #fff9;border-radius:20px;background:#160d2bcc;text-align:center;font-size:22px;font-weight:800}
.answers{display:grid;grid-template-columns:1fr 1fr;gap:24px}.answer{min-height:85px;border:2px solid #fff8;border-radius:18px;background:#2c1b49;color:white;font-size:18px;font-weight:700;cursor:pointer}.answer:hover{background:#45256e}.answer.removed{visibility:hidden}
.status{text-align:center;margin-top:22px;font-weight:bold}.progress{text-align:center;margin-top:12px;opacity:.8;font-size:14px}
.overlay{position:fixed;inset:0;background:#08040dcc;display:flex;align-items:center;justify-content:center;padding:20px;z-index:10}.modal{position:relative;width:min(400px,100%);background:#25183f;border:2px solid #a78bfa;border-radius:25px;padding:28px;text-align:center;box-shadow:0 20px 60px #0009}
.close{position:absolute;right:12px;top:10px;width:38px;height:38px;border:0;border-radius:50%;background:#ffffff18;color:#fff;font-size:25px;font-weight:bold;cursor:pointer}.close:hover{background:#ffffff35}
.timer{font-size:72px;font-weight:900;letter-spacing:3px;margin:22px 0 10px}.timer.warning{color:#ffd000;animation:pulse .7s infinite alternate}.call-icon{font-size:48px;animation:ring .8s infinite alternate}.small{opacity:.8;font-size:14px}
.wheel-wrap{width:210px;height:210px;margin:18px auto;position:relative}.wheel{width:210px;height:210px;border-radius:50%;border:8px solid white;background:conic-gradient(#8b5cf6 0 25%,#ec4899 25% 50%,#06b6d4 50% 75%,#f59e0b 75% 100%);animation:spin 1.9s cubic-bezier(.15,.75,.25,1) infinite}.pointer{position:absolute;z-index:2;top:-12px;left:50%;transform:translateX(-50%);width:0;height:0;border-left:14px solid transparent;border-right:14px solid transparent;border-top:28px solid white}
.play{margin-top:25px;border:0;border-radius:16px;padding:15px 35px;font-size:20px;font-weight:900;color:white;background:#8b5cf6;cursor:pointer}
@keyframes spin{to{transform:rotate(1440deg)}}@keyframes pulse{to{transform:scale(1.06)}}@keyframes ring{to{transform:rotate(12deg) scale(1.08)}}
@media(max-width:600px){.answers{grid-template-columns:1fr;gap:14px}.logo{font-size:21px}.life{width:44px;height:44px}.question{font-size:19px}}
</style>
</head>
<body>
<div class="game">
<div class="top"><div class="logo">EL CONCURSILLO</div><div class="lifelines">
<button class="life" id="fifty" title="50/50">50</button>
<button class="life" id="call" title="Llamada">📞</button>
<button class="life" id="roulette" title="Ruleta">🎰</button>
<button class="life" id="wizard" title="Mago">🔒</button>
</div></div>
<div class="question" id="question"></div>
<div class="answers" id="answers"></div>
<div class="status" id="status"></div>
<div class="progress" id="progress"></div>
</div>

<script>
const questions=[
/* 5 FÁCILES */
{level:"Fácil",q:"¿Cuál es la capital de Ecuador?",a:["Quito","Guayaquil","Cuenca","Loja"],c:0},
{level:"Fácil",q:"¿Cuántos días tiene una semana?",a:["5","6","7","8"],c:2},
{level:"Fácil",q:"¿Qué planeta es conocido como el planeta rojo?",a:["Venus","Marte","Júpiter","Saturno"],c:1},
{level:"Fácil",q:"¿Cuánto es 5 + 5?",a:["8","9","10","11"],c:2},
{level:"Fácil",q:"¿Qué animal dice “miau”?",a:["Perro","Gato","Caballo","Vaca"],c:1},

/* 5 INTERMEDIAS */
{level:"Intermedio",q:"¿Cuál es el océano más grande del mundo?",a:["Atlántico","Índico","Pacífico","Ártico"],c:2},
{level:"Intermedio",q:"¿En qué año llegó el ser humano a la Luna?",a:["1965","1969","1972","1975"],c:1},
{level:"Intermedio",q:"¿Cuál es el símbolo químico del oro?",a:["Ag","Au","Fe","O"],c:1},
{level:"Intermedio",q:"¿Quién escribió Don Quijote de la Mancha?",a:["Miguel de Cervantes","William Shakespeare","Pablo Neruda","Jorge Luis Borges"],c:0},
{level:"Intermedio",q:"¿Cuál es el río más largo de Sudamérica?",a:["Amazonas","Orinoco","Paraná","Magdalena"],c:0},

/* 5 DIFÍCILES */
{level:"Difícil",q:"¿Cuál es la unidad de resistencia eléctrica?",a:["Voltio","Amperio","Ohmio","Watt"],c:2},
{level:"Difícil",q:"¿Cuál es el elemento químico con número atómico 79?",a:["Plata","Oro","Platino","Mercurio"],c:1},
{level:"Difícil",q:"¿Quién formuló las tres leyes del movimiento?",a:["Albert Einstein","Isaac Newton","Galileo Galilei","Nikola Tesla"],c:1},
{level:"Difícil",q:"¿Cuál es la capital de Mongolia?",a:["Ulán Bator","Astaná","Tiflis","Biskek"],c:0},
{level:"Difícil",q:"¿Qué órgano produce principalmente la insulina?",a:["Hígado","Riñón","Páncreas","Corazón"],c:2}
];

let index=0,current=null,locked=false,used50=false,usedCall=false,usedRoulette=false,usedWizard=false;
let timerId=null,seconds=90;

const qEl=document.getElementById("question"),answersEl=document.getElementById("answers");
const status=document.getElementById("status"),progress=document.getElementById("progress");
const fifty=document.getElementById("fifty"),call=document.getElementById("call");
const roulette=document.getElementById("roulette"),wizard=document.getElementById("wizard");

function loadQuestion(){
 if(index>=questions.length){finish();return}
 current=questions[index];
 qEl.innerHTML=`Pregunta ${index+1} de 15<br><span style="opacity:.75;font-size:15px">${current.level}</span><br>${current.q}`;
 progress.textContent=`${index<5?"Nivel fácil":index<10?"Nivel intermedio":"Nivel difícil"} · ${index+1}/15`;
 answersEl.innerHTML="";
 status.textContent="";
 current.a.forEach((x,i)=>{
  const b=document.createElement("button");
  b.className="answer";b.textContent=String.fromCharCode(65+i)+". "+x;
  b.onclick=()=>answer(i,b);answersEl.appendChild(b);
 });
 wizard.disabled=index+1<10||usedWizard;
 wizard.textContent=index+1>=10?"🧙":"🔒";
}

function answer(i,b){
 if(locked)return;
 locked=true;
 const bs=[...answersEl.children];bs.forEach(x=>x.disabled=true);
 if(i===current.c){
  b.style.background="#16803c";status.textContent="✅ ¡Respuesta correcta!";
  setTimeout(()=>{index++;locked=false;loadQuestion()},800);
 }else{
  b.style.background="#9f1d35";bs[current.c].style.background="#16803c";
  status.textContent="❌ Respuesta incorrecta";
  setTimeout(()=>{index++;locked=false;loadQuestion()},1200);
 }
}

fifty.onclick=()=>{
 if(locked||used50)return;
 used50=true;fifty.disabled=true;
 const wrong=[0,1,2,3].filter(i=>i!==current.c).sort(()=>Math.random()-.5).slice(0,2);
 wrong.forEach(i=>answersEl.children[i].classList.add("removed"));
};

call.onclick=()=>{
 if(locked||usedCall)return;
 usedCall=true;call.disabled=true;seconds=90;openCall();
};

function openCall(){
 const old=document.querySelector(".overlay");if(old)old.remove();
 const overlay=document.createElement("div");overlay.className="overlay";
 overlay.innerHTML=`<div class="modal">
 <button class="close" id="closeCall">×</button>
 <div class="call-icon">📞</div><div style="font-size:25px;font-weight:900">LLAMADA</div>
 <div class="small">Tiempo restante</div><div class="timer" id="timer">1:30</div>
 <div class="small" id="callText">La llamada está activa...</div></div>`;
 document.body.appendChild(overlay);
 const timer=overlay.querySelector("#timer"),text=overlay.querySelector("#callText");
 const close=()=>{clearInterval(timerId);timerId=null;overlay.remove()};
 overlay.querySelector("#closeCall").onclick=close;
 clearInterval(timerId);
 timerId=setInterval(()=>{
  seconds--;timer.textContent=Math.floor(seconds/60)+":"+String(seconds%60).padStart(2,"0");
  if(seconds<=10&&seconds>0)timer.classList.add("warning");
  if(seconds<=0){clearInterval(timerId);timerId=null;timer.textContent="0:00";timer.classList.remove("warning");text.textContent="⏰ ¡Se acabó el tiempo! Pulsa × para cerrar."}
 },1000);
}

roulette.onclick=()=>{
 if(locked||usedRoulette)return;
 usedRoulette=true;roulette.disabled=true;locked=true;
 const overlay=document.createElement("div");overlay.className="overlay";
 overlay.innerHTML=`<div class="modal"><div style="font-size:25px;font-weight:900">🎰 RULETA</div>
 <div class="wheel-wrap"><div class="pointer"></div><div class="wheel"></div></div><div>Girando...</div></div>`;
 document.body.appendChild(overlay);
 setTimeout(()=>{
  const amount=Math.floor(Math.random()*4);
  const wrong=[0,1,2,3].filter(i=>i!==current.c).sort(()=>Math.random()-.5).slice(0,amount);
  wrong.forEach(i=>answersEl.children[i].classList.add("removed"));
  overlay.querySelector(".modal").innerHTML=`<button class="close" id="closeRoulette">×</button>
  <div style="font-size:25px;font-weight:900">🎰 RESULTADO</div>
  <div style="font-size:30px;font-weight:900;margin:25px">${amount} respuesta${amount===1?"":"s"} eliminada${amount===1?"":"s"}</div>
  <div class="small">La respuesta correcta nunca se elimina.</div>`;
  overlay.querySelector("#closeRoulette").onclick=()=>{overlay.remove();locked=false};
 },1900);
};

wizard.onclick=()=>{
 if(locked||index+1<10||usedWizard)return;
 usedWizard=true;wizard.disabled=true;
 const pool=questions.filter((q,i)=>q.level===current.level&&i!==index);
 current=pool[Math.floor(Math.random()*pool.length)];
 qEl.innerHTML=`Pregunta ${index+1} de 15<br><span style="opacity:.75;font-size:15px">${current.level}</span><br>${current.q}`;
 answersEl.innerHTML="";
 current.a.forEach((x,i)=>{const b=document.createElement("button");b.className="answer";b.textContent=String.fromCharCode(65+i)+". "+x;b.onclick=()=>answer(i,b);answersEl.appendChild(b)});
 status.textContent="🧙 El mago cambió la pregunta.";
};

function finish(){
 const overlay=document.createElement("div");overlay.className="overlay";
 overlay.innerHTML=`<div class="modal"><div style="font-size:50px">🏆</div><div style="font-size:28px;font-weight:900">¡CONCURSO TERMINADO!</div>
 <div class="small" style="margin-top:10px">Has completado las 15 preguntas.</div>
 <button class="play" onclick="location.reload()">JUGAR DE NUEVO</button></div>`;
 document.body.appendChild(overlay);
}
loadQuestion();
</script>
</body>
</html>
